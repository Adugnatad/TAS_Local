# Browser-facing API prefix. Calls Next.js Route Handlers under /api/*.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_API_URL=/api

# Portal Core URL used by the BFF proxy (src/app/api/_lib/portal.ts).
API_UPSTREAM_URL=http://localhost:8080/api/v1

# Optional explicit WebSocket URL for STOMP notifications (defaults to same-origin /ws).
# NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
